# See http://help.github.com/ignore-files/ for more about ignoring files.
# backup files
*~
*.bak

# compiled output
/dist
/tmp
/out-tsc
/app-builds
/release
/target
/src-tauri/gen
/src-tauri/target
index.js
preload.js
src/**/*.js
!src/karma.conf.js
*.js.map
.angular/
.nx/

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/logs
/libpeerconnection.log
npm-debug.log
testem.log
/typings

# e2e
/e2e/*.js
!/e2e/protractor.conf.js
/e2e/*.map

# System Files
.DS_Store
Thumbs.db

local.properties
.env
.env.*
!.env.example

### Fastlane

# fastlane specific
**/fastlane/report.xml

# deliver temporary files
**/fastlane/Preview.html

# snapshot generated screenshots
**/fastlane/screenshots

# scan temporary files
**/fastlane/test_output

.secrets

# Bundled tool binaries (platform-specific, downloaded via scripts/download-adb.sh)
src-tauri/binaries/

# Build artifacts / test packages — never commit these
*.wgt
*.apk
*.ipk
*.tpk

# VS Code local history plugin
.history/

# Session notes and temp plan files
SESSION_SUMMARY_*.md
WGT-INSTALL-PLAN.md

# Claude Code local settings
.claude/settings.local.json
.claude/worktrees/

# Stray screen recordings / media
*.mp4
