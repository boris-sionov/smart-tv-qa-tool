{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run ng build",
    "beforeDevCommand": "npm run ng serve -- --port 4281",
    "devUrl": "http://localhost:4281",
    "frontendDist": "../dist"
  },
  "identifier": "com.smarttv.qa-tool",
  "productName": "Smart TV QA Tool",
  "version": "../package.json",
  "app": {
    "security": {
      "csp": null,
      "devCsp": "default-src 'self' localhost"
    },
    "windows": [
      {
        "dragDropEnabled": false,
        "fullscreen": false,
        "height": 720,
        "label": "main",
        "minHeight": 600,
        "minWidth": 420,
        "resizable": true,
        "title": "Smart TV QA Tool",
        "visible": true,
        "width": 1024
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": ".*"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 Smart TV QA Tool",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "desktopTemplate": "./assets/app.desktop",
        "depends": [
          "zlib1g (>=1.2.11)"
        ],
        "provides": [
          "smart-tv-qa-tool"
        ],
        "conflicts": [
          "smart-tv-qa-tool"
        ],
        "replaces": [
          "smart-tv-qa-tool"
        ]
      },
      "rpm": {
        "desktopTemplate": "./assets/app.desktop",
        "depends": [
          "zlib (>=1.2.11)"
        ],
        "provides": [
          "smart-tv-qa-tool"
        ],
        "conflicts": [
          "smart-tv-qa-tool"
        ],
        "obsoletes": [
          "smart-tv-qa-tool"
        ]
      }
    },
    "externalBin": ["binaries/adb", "binaries/sdb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Smart TV QA Tool for testing and managing applications across multiple Smart TV platforms\n\nFeatures\n- Manage apps on LG WebOS devices\n- Install and test apps via ADB on Android TV\n- Support for multiple platforms and environments\n- Device management and app installation capabilities\n- Works on Windows, Linux and macOS (Apple Silicon too!)\n- Modern dark mode interface",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "QA Tool for Smart TV Testing",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "silent": false,
        "type": "embedBootstrapper"
      },
      "wix": {}
    },
    "android": {
      "minSdkVersion": 28
    }
  }
}